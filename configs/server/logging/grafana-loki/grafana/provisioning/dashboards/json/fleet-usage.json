{
  "uid": "fleet-usage",
  "title": "Fleet Usage",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "fleet"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "custom",
        "query": "dorm,hip-japan,hip-usa,hip-fin,hip-nid,nuxt-fin",
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "links": [
    {
      "title": "Overview",
      "url": "/d/fleet-overview",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Usage",
      "url": "/d/fleet-usage",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Problems",
      "url": "/d/fleet-problems",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Services",
      "url": "/d/fleet-services",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Security",
      "url": "/d/fleet-security",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "All logs",
      "url": "/d/fleet-logs",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "title": "CPU utilization",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by(host) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))) and on(host) node_time_seconds{host=~\"$host\"}",
          "legendFormat": "{{host}} {{mountpoint}} {{gpu}}",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "RAM utilization",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) and on(host) node_time_seconds{host=~\"$host\"}",
          "legendFormat": "{{host}} {{mountpoint}} {{gpu}}",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Incoming traffic",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host) (rate(node_network_receive_bytes_total[5m])) * 8 / 1e6 and on(host) node_time_seconds{host=~\"$host\"}",
          "legendFormat": "{{host}} {{mountpoint}} {{gpu}}",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "Mbits"
        },
        "overrides": []
      },
      "options": {},
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Incoming packets/second",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host) (rate(node_network_receive_packets_total[1m])) and on(host) node_time_seconds{host=~\"$host\"}",
          "legendFormat": "{{host}} {{mountpoint}} {{gpu}}",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "pps"
        },
        "overrides": []
      },
      "options": {},
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Incoming transferred in selected period",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host)(increase(node_network_receive_bytes_total{host=~\"$host\"}[$__range]))",
          "legendFormat": "{{host}} {{mountpoint}} {{gpu}}",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Outgoing traffic",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host) (rate(node_network_transmit_bytes_total[5m])) * 8 / 1e6 and on(host) node_time_seconds{host=~\"$host\"}",
          "legendFormat": "{{host}} {{mountpoint}} {{gpu}}",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "Mbits"
        },
        "overrides": []
      },
      "options": {},
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Outgoing packets/second",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host) (rate(node_network_transmit_packets_total[1m])) and on(host) node_time_seconds{host=~\"$host\"}",
          "legendFormat": "{{host}} {{mountpoint}} {{gpu}}",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "pps"
        },
        "overrides": []
      },
      "options": {},
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Outgoing transferred in selected period",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host)(increase(node_network_transmit_bytes_total{host=~\"$host\"}[$__range]))",
          "legendFormat": "{{host}} {{mountpoint}} {{gpu}}",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "bytes"
