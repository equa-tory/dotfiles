{
  "uid": "fleet-logs",
  "title": "Fleet Logs",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "fleet"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "custom",
        "query": "dorm,hip-japan,hip-usa,hip-fin,hip-nid,nuxt-fin",
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "query": "label_values({host=~\"$host\",host!=\"\"}, service_name)",
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "datasource": {
          "type": "loki",
          "uid": "__LOKI_UID__"
        },
        "refresh": 1
      },
      {
        "name": "source",
        "label": "Source",
        "type": "query",
        "query": "label_values({host=~\"$host\",host!=\"\"}, source)",
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "datasource": {
          "type": "loki",
          "uid": "__LOKI_UID__"
        },
        "refresh": 1
      },
      {
        "name": "text",
        "label": "Contains literal text",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "preset",
        "label": "Search preset",
        "type": "custom",
        "query": "All : |~ \".*\",Errors : |~ \"(?i)error|failed|fatal\",Exceptions : |~ \"(?i)exception|traceback|panic|segfault\",SSH : |~ \"(?i)sshd|ssh|Accepted publickey|Accepted password\",Sudo : |~ \"(?i)sudo|; USER=.*; COMMAND=\",Package updates : |~ \"(?i)apt|dpkg|upgrade|pacman|installed\",Journal : | source=\"journal\",Docker : | source=\"docker\"",
        "current": {
          "text": "All",
          "value": "|~ \".*\""
        },
        "options": [
          {
            "text": "All",
            "value": "|~ \".*\"",
            "selected": true
          },
          {
            "text": "Errors",
            "value": "|~ \"(?i)error|failed|fatal\"",
            "selected": false
          },
          {
            "text": "Exceptions",
            "value": "|~ \"(?i)exception|traceback|panic|segfault\"",
            "selected": false
          },
          {
            "text": "SSH",
            "value": "|~ \"(?i)sshd|ssh|Accepted publickey|Accepted password\"",
            "selected": false
          },
          {
            "text": "Sudo",
            "value": "|~ \"(?i)sudo|; USER=.*; COMMAND=\"",
            "selected": false
          },
          {
            "text": "Package updates",
            "value": "|~ \"(?i)apt|dpkg|upgrade|pacman|installed\"",
            "selected": false
          },
          {
            "text": "Journal",
            "value": "| source=\"journal\"",
            "selected": false
          },
          {
            "text": "Docker",
            "value": "| source=\"docker\"",
            "selected": false
          }
        ]
      }
    ]
  },
  "links": [
    {
      "title": "Overview",
      "url": "/d/fleet-overview",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Usage",
      "url": "/d/fleet-usage",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Problems",
      "url": "/d/fleet-problems",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Services",
      "url": "/d/fleet-services",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Security",
      "url": "/d/fleet-security",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "All logs",
      "url": "/d/fleet-logs",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Clear filters",
      "url": "/d/fleet-logs?${host:queryparam}&var-service=%24__all&var-source=%24__all&var-text=&var-preset=%7C~%20%22.%2A%22",
      "keepTime": true
    }
  ],
  "panels": [
    {
      "title": "All logs",
      "type": "logs",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{host=~\"$host\",host!=\"\",service_name=~\"$service\",source=~\"$source\"} ${preset:raw} | label_format __fleet_literal_match=`{{ contains (urldecode \"${text:percentencode}\") (__line__) }}` | __fleet_literal_match=\"true\" | drop __fleet_literal_match",
          "legendFormat": "{{host}} {{mountpoint}} {{gpu}}",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      }
    }
  ],
  "annotations": {
    "list": []
  }
}