{
  "uid": "fleet-security",
  "title": "Fleet Security",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "fleet"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "custom",
        "query": "dorm,hip-japan,hip-usa,hip-fin,hip-nid,nuxt-fin",
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "links": [
    {
      "title": "Overview",
      "url": "/d/fleet-overview",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Usage",
      "url": "/d/fleet-usage",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Problems",
      "url": "/d/fleet-problems",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Services",
      "url": "/d/fleet-services",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Security",
      "url": "/d/fleet-security",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "All logs",
      "url": "/d/fleet-logs",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "title": "Successful SSH logins",
      "type": "logs",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{host=~\"$host\",host!=\"\",source=\"journal\",service_name=~\"ssh.*\"} |~ \"Accepted (publickey|password) for \"",
          "legendFormat": "{{host}} {{mountpoint}} {{gpu}}",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      }
    },
    {
      "title": "Failed SSH attempts",
      "type": "logs",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{host=~\"$host\",host!=\"\",service_name=~\"ssh.*\"} |~ \"(?i)failed (password|publickey|keyboard-interactive)|invalid user|authentication failure|maximum authentication attempts\"",
          "legendFormat": "{{host}} {{mountpoint}} {{gpu}}",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      }
    },
    {
      "title": "Sudo",
      "type": "logs",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{host=~\"$host\",host!=\"\"} |~ \"(?i)sudo|; USER=.*; COMMAND=|pam_unix\\\\(sudo\"",
          "legendFormat": "{{host}} {{mountpoint}} {{gpu}}",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      }
    },
    {
      "title": "New accounts",
      "type": "logs",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{host=~\"$host\",host!=\"\",service_name=~\"fleet-accounts(.service)?\"} |= \"new_local_account \"",
          "legendFormat": "{{host}} {{mountpoint}} {{gpu}}",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      }
    },
    {
      "title": "Fail2ban",
      "type": "logs",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{host=~\"$host\",host!=\"\"} |~ \"(?i)fail2ban|\\\\bBan |\\\\bUnban \"",
          "legendFormat": "{{host}} {{mountpoint}} {{gpu}}",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      }
    }
  ],
