{
  "uid": "fleet-problems",
  "title": "Fleet Problems",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "fleet"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "custom",
        "query": "dorm,hip-japan,hip-usa,hip-fin,hip-nid,nuxt-fin",
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "links": [
    {
      "title": "Overview",
      "url": "/d/fleet-overview",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Usage",
      "url": "/d/fleet-usage",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Problems",
      "url": "/d/fleet-problems",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Services",
      "url": "/d/fleet-services",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Security",
      "url": "/d/fleet-security",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "All logs",
      "url": "/d/fleet-logs",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "alertlist",
      "title": "Active alerts",
      "options": {
        "stateFilter": {
          "firing": true,
          "pending": true,
          "error": true,
          "noData": true
        },
        "maxItems": 100,
        "sortOrder": 1,
        "viewMode": "list",
        "groupMode": "default"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      }
    },
    {
      "title": "Errors, exceptions and crashes",
      "type": "logs",
      "description": "Text patterns are a search aid, not a complete exception detector.",
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{host=~\"$host\",host!=\"\"} |~ \"(?i)exception|traceback|panic|segfault|core dumped|fatal|failed|failure|error\"",
          "legendFormat": "{{host}} {{mountpoint}} {{gpu}}",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      }
    }
  ],
  "annotations": {
    "list": []
  }
}