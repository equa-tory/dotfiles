          "expr": "(100 * (1 - node_filesystem_avail_bytes{host=\"dorm\"} / node_filesystem_size_bytes) and (node_filesystem_readonly == 0) and on(host) (node_time_seconds{host=\"dorm\"} > time()-300)) or on(host) (fleet_expected_host{host=\"dorm\"} * (0/0))",
