{
  "uid": "fleet-overview",
  "title": "Fleet Overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "fleet"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "custom",
        "query": "dorm,hip-japan,hip-usa,hip-fin,hip-nid,nuxt-fin",
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "links": [
    {
      "title": "Overview",
      "url": "/d/fleet-overview",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Usage",
      "url": "/d/fleet-usage",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
