    {
      "type": "row",
      "title": "dorm",
      "collapsed": false,
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      }
    },
    {
      "title": "dorm \u00b7 Collection health",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max by(host)(timestamp(node_time_seconds{host=\"dorm\"}) > bool time()-300)) or on(host) (fleet_expected_host{host=\"dorm\"} * (0/0))",
          "legendFormat": "Metrics",
          "range": false,
          "queryType": "range",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "__LOKI_UID__"
          },
          "expr": "sum(count_over_time({host=\"dorm\",source=\"journal\",service_name=~\"fleet-heartbeat(.service)?\"} |= \"fleet_heartbeat\" [5m])) > bool 0 or vector(0)",
          "queryType": "instant",
          "legendFormat": "Logs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Fresh",
                  "color": "green"
                },
                "0": {
                  "text": "Unavailable",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {},
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 4,
        "h": 5
      }
    },
    {
      "title": "dorm \u00b7 CPU",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * (1 - avg by(host) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))) and on(host) (node_time_seconds{host=\"dorm\"} > time()-300)) or on(host) (fleet_expected_host{host=\"dorm\"} * (0/0))",
          "legendFormat": "{{host}} {{mountpoint}} {{gpu}}",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "id": 4,
      "gridPos": {
        "x": 4,
        "y": 6,
        "w": 4,
        "h": 5
      }
    },
