      "title": "dorm \u00b7 RAM",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) and on(host) (node_time_seconds{host=\"dorm\"} > time()-300)) or on(host) (fleet_expected_host{host=\"dorm\"} * (0/0))",
          "legendFormat": "{{host}} {{mountpoint}} {{gpu}}",
          "range": true,
          "queryType": "range"
